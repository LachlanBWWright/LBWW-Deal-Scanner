// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}
model ActionRegistry {
  id         String   @id
  type       String   // "delete" | "confirm_delete" | "cancel_delete"
  queryType  String?
  queryId    String?
  userId     String?
  timestamp  BigInt   // Store as BigInt for JavaScript timestamp compatibility
  relatedKey String?
  createdAt  DateTime @default(now())
}model Globals {
    id                         String  @unique
    BOT_CLIENT_ID              String
    CASH_CONVERTERS            Boolean
    CASH_CONVERTERS_CHANNEL_ID String
    CASH_CONVERTERS_ROLE_ID    String
    COMMAND_PERMISSION_ROLE_ID String
    CS_CHANNEL_ID              String
    CS_ITEMS                   Boolean
    CS_MARKET_CHANNEL_ID       String
    CS_MARKET_ROLE_ID          String
    CS_ROLE_ID                 String
    DISCORD_GUILD_ID           String
    DISCORD_TOKEN              String
    EBAY                       Boolean
    EBAY_CHANNEL_ID            String
    EBAY_ROLE_ID               String
    ERROR_CHANNEL_ID           String
    GUMTREE                    Boolean
    GUMTREE_CHANNEL_ID         String
    GUMTREE_ROLE_ID            String
    SALVOS                     Boolean
    SALVOS_CHANNEL_ID          String
    SALVOS_ROLE_ID             String
    STEAM_QUERY                Boolean
    STEAM_QUERY_CHANNEL_ID     String
    STEAM_QUERY_ROLE_ID        String
    //CS Trade Bot Price Offsets
    CS_TRADE_DOLLAR_RATIO      Float   @default(1)
    LOOT_FARM_DOLLAR_RATIO     Float   @default(1)
    CS_DEALS_DOLLAR_RATIO      Float   @default(1)
    TRADEIT_GG_DOLLAR_RATIO    Float   @default(1)
}
model TtlItem {
    itemId      String   @unique
    scanner     Int
    lastUpdated DateTime

    @@id(name: "id", [scanner, itemId])
    @@unique([scanner, itemId])
}
model CashConverters {
    url             String @unique
    requiredPhrases String @default("")
    excludePhrases  String @default("")
}
model CsMarket {
    url        String @unique
    displayUrl String
    maxPrice   Float
    maxFloat   Float
    lastPrice  Float
}
model CsTradeBot {
    name     String @unique
    maxPrice Float
    minFloat Float
    maxFloat Float
}
model Ebay {
    url      String @unique
    maxPrice Float
}
model Gumtree {
    url      String @unique
    maxPrice Float
}
model Salvos {
    name     String @unique
    minPrice Float
    maxPrice Float
}
model SteamMarket {
    name       String @unique
    displayUrl String
    maxPrice   Float
    lastPrice  Float
}
