generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ActionRegistry {
  id         String   @id
  type       String
  queryType  String?
  queryId    String?
  userId     String?
  timestamp  BigInt
  relatedKey String?
  createdAt  DateTime @default(now())
}

model Globals {
  id                         String  @unique
  BOT_CLIENT_ID              String
  CASH_CONVERTERS            Boolean
  CASH_CONVERTERS_CHANNEL_ID String
  CASH_CONVERTERS_ROLE_ID    String
  COMMAND_PERMISSION_ROLE_ID String
  CS_CHANNEL_ID              String
  CS_ITEMS                   Boolean
  CS_MARKET_CHANNEL_ID       String
  CS_MARKET_ROLE_ID          String
  CS_ROLE_ID                 String
  DISCORD_GUILD_ID           String
  DISCORD_TOKEN              String
  EBAY                       Boolean
  EBAY_CHANNEL_ID            String
  EBAY_ROLE_ID               String
  ERROR_CHANNEL_ID           String
  GUMTREE                    Boolean
  GUMTREE_CHANNEL_ID         String
  GUMTREE_ROLE_ID            String
  SALVOS                     Boolean
  SALVOS_CHANNEL_ID          String
  SALVOS_ROLE_ID             String
  STEAM_QUERY                Boolean
  STEAM_QUERY_CHANNEL_ID     String
  STEAM_QUERY_ROLE_ID        String
  CS_TRADE_DOLLAR_RATIO      Float   @default(1)
  LOOT_FARM_DOLLAR_RATIO     Float   @default(1)
  CS_DEALS_DOLLAR_RATIO      Float   @default(1)
  TRADEIT_GG_DOLLAR_RATIO    Float   @default(1)
}

model TtlItem {
  itemId      String   @unique
  scanner     Int
  lastUpdated DateTime

  @@id([scanner, itemId], name: "id")
  @@unique([scanner, itemId])
}

model Query {
  id             String          @id @default(cuid())
  dmOnly         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  cashConverters CashConverters?
  csMarket       CsMarket?
  csTradeBot     CsTradeBot?
  ebay           Ebay?
  gumtree        Gumtree?
  salvos         Salvos?
  steamMarket    SteamMarket?
  userQueries    UserQuery[]
}

model UserQuery {
  id        String   @id @default(cuid())
  userId    String
  queryId   String
  queryType String
  createdAt DateTime @default(now())
  query     Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@unique([userId, queryId])
}

model CashConverters {
  url             String  @unique
  requiredPhrases String  @default("")
  excludePhrases  String  @default("")
  queryId         String? @unique
  query           Query?  @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model CsMarket {
  url        String  @unique
  displayUrl String
  maxPrice   Float
  maxFloat   Float
  lastPrice  Float
  queryId    String? @unique
  query      Query?  @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model CsTradeBot {
  name     String  @unique
  maxPrice Float
  minFloat Float
  maxFloat Float
  queryId  String? @unique
  query    Query?  @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model Ebay {
  url      String  @unique
  maxPrice Float
  queryId  String? @unique
  query    Query?  @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model Gumtree {
  url      String  @unique
  maxPrice Float
  queryId  String? @unique
  query    Query?  @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model Salvos {
  name     String  @unique
  minPrice Float
  maxPrice Float
  queryId  String? @unique
  query    Query?  @relation(fields: [queryId], references: [id], onDelete: Cascade)
}

model SteamMarket {
  name       String  @unique
  displayUrl String
  maxPrice   Float
  lastPrice  Float
  queryId    String? @unique
  query      Query?  @relation(fields: [queryId], references: [id], onDelete: Cascade)
}
